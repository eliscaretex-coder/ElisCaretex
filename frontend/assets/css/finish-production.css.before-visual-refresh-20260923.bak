/* Snapshot 118 — strict Available list, large planned KG, priority-sorted Saved today */
.finish-metrics{grid-template-columns:repeat(4,minmax(0,1fr))}
.finish-kpi.produced{background:#f0fdf4}.finish-kpi.planned{background:#eff6ff}.finish-kpi.target-now{background:#fff}.finish-kpi.efficiency{background:#f0fdfa}
.finish-kpi.planned strong{color:#1d4ed8}
.finish-queue-line{grid-template-columns:25px 36px minmax(0,1fr) 54px auto}
.finish-queue-planned{display:flex;flex-direction:column;align-items:flex-end;justify-content:center;line-height:1}.finish-queue-planned strong{font-size:.82rem;color:#0f172a;font-variant-numeric:tabular-nums}.finish-queue-planned small{margin-top:2px;font-size:.49rem;color:#64748b;text-transform:uppercase;font-weight:900;letter-spacing:.025em;white-space:nowrap}
.finish-queue-line.processed .finish-queue-planned strong,.finish-queue-line.continue .finish-queue-planned strong{color:#64748b}
.finish-queue-day{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:7px 1px 2px;padding:5px 7px;border:1px solid #dbe4ea;border-radius:6px;background:#f8fafc;color:#475569;font-size:.61rem;font-weight:800}.finish-queue-day strong{color:#334155;font-size:.63rem}.finish-queue-day span{font-variant-numeric:tabular-nums}.finish-queue-day.today{border-color:#99f6e4;background:#f0fdfa}.finish-queue-day.today strong{color:#0f766e}.finish-queue-day.yesterday,.finish-queue-day.earlier-schedule{border-color:#fde68a;background:#fffbeb}.finish-queue-day.yesterday strong,.finish-queue-day.earlier-schedule strong{color:#a16207}.finish-queue-day.tomorrow,.finish-queue-day.upcoming-schedule{border-color:#bfdbfe;background:#eff6ff}.finish-queue-day.tomorrow strong,.finish-queue-day.upcoming-schedule strong{color:#1d4ed8}
.finish-staff-form .finish-staff-name-field,.finish-staff-form .finish-message,.finish-staff-form .finish-form-actions{grid-column:1/-1}.finish-staff-form label:nth-of-type(4){grid-column:auto}
.finish-staff-form label:nth-of-type(5){grid-column:1/-1}
.finish-staff-time-editor{grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.finish-staff-time-editor .finish-staff-name-field,.finish-staff-time-editor label:nth-of-type(2),.finish-staff-time-editor .finish-staff-note-field,.finish-staff-time-editor .finish-message,.finish-staff-time-editor .finish-form-actions{grid-column:1/-1}.finish-staff-time-editor .finish-staff-clock-field{grid-column:auto!important}.finish-staff-time-editor .finish-staff-clock-field small{display:block;margin-top:3px;color:#64748b;font-size:.65rem;font-weight:600;line-height:1.35}.finish-staff-time-editor .finish-staff-note-field input{min-height:38px}
.finish-staff-time-editor .finish-staff-departure-toggle{grid-column:1/-1;display:flex;align-items:center;gap:7px;margin-top:-2px;color:#334155;font-size:.72rem;font-weight:750}.finish-staff-time-editor .finish-staff-departure-toggle input[type="checkbox"]{width:16px;height:16px;min-width:16px;margin:0;padding:0;accent-color:#0f766e}
.finish-staff-simple-table table{min-width:860px}
@media(max-width:700px){.finish-staff-time-editor{grid-template-columns:1fr}.finish-staff-time-editor .finish-staff-clock-field{grid-column:auto!important}}
.finish-staff-overview-card .finish-card-header{align-items:center}.finish-staff-overview-card .finish-card-header>div{min-width:0}.finish-staff-overview-card .finish-card-header>div p{margin:0 0 2px}.finish-staff-overview-card .finish-card-header>div span{display:block;color:#64748b;font-size:.72rem}.finish-staff-overview-card .finish-card-header .secondary{margin-left:auto}.finish-staff-simple-table{overflow:auto;padding:0}.finish-staff-simple-table table{width:100%;min-width:720px;border-collapse:collapse;font-size:.76rem}.finish-staff-simple-table th{padding:8px 10px;background:#f8fafc;border-bottom:1px solid #dbe4ea;color:#64748b;font-size:.62rem;font-weight:900;letter-spacing:.04em;text-align:left;text-transform:uppercase}.finish-staff-simple-table td{padding:9px 10px;border-bottom:1px solid #eef2f7;vertical-align:middle}.finish-staff-simple-table tbody tr:last-child td{border-bottom:0}.finish-staff-simple-table td strong,.finish-staff-simple-table td b,.finish-staff-simple-table td small{display:block}.finish-staff-simple-table td strong{font-size:.82rem;color:#0f172a}.finish-staff-simple-table td b{font-size:.72rem;color:#334155}.finish-staff-simple-table td small{margin-top:2px;color:#64748b;font-size:.65rem}.finish-staff-simple-table td:last-child{width:1%;white-space:nowrap}.finish-staff-simple-table .finish-staff-edit{margin:0;padding:6px 8px;font-size:.68rem}.finish-staff-simple-state{display:inline-flex;border-radius:999px;padding:3px 6px;font-size:.62rem;font-weight:850}.finish-staff-simple-state.confirmed{background:#dcfce7;color:#166534}.finish-staff-simple-state.planned{background:#e0f2fe;color:#0369a1}.finish-staff-simple-state.elsewhere{background:#e2e8f0;color:#475569}
.finish-staff-simple-state.absent{background:#fee2e2;color:#b91c1c}.finish-staff-actions{display:flex;align-items:center;gap:5px}.finish-staff-actions .finish-staff-edit:disabled{cursor:not-allowed;opacity:.45}.danger-outline{border-color:#fecaca!important;background:#fff!important;color:#b91c1c!important}.danger{border:1px solid #b91c1c;background:#b91c1c;color:#fff}.finish-staff-action-dialog{width:min(560px,calc(100vw - 24px))}.finish-staff-action-form{display:grid;grid-template-columns:1fr 1fr;gap:8px}.finish-staff-action-form .finish-staff-action-wide,.finish-staff-action-form .finish-message,.finish-staff-action-form .finish-form-actions{grid-column:1/-1}@media(max-width:700px){.finish-staff-action-form{grid-template-columns:1fr}.finish-staff-action-form .finish-staff-action-wide,.finish-staff-action-form .finish-message,.finish-staff-action-form .finish-form-actions{grid-column:auto}.finish-staff-actions{flex-wrap:wrap}.finish-staff-simple-table table{min-width:780px}}
@media(max-width:700px){.finish-metrics{grid-template-columns:1fr 1fr}.finish-kpi:nth-child(-n+2){border-bottom:1px solid #e2e8f0}.finish-queue-line{grid-template-columns:25px 34px minmax(0,1fr) 50px}.finish-queue-status{grid-column:3/5;justify-self:end}}

/* Operational queue summary and delivery reconciliation. */
.finish-queue-summary{display:flex;align-items:center;gap:5px}.finish-queue-washed-summary{display:block;max-width:108px;color:#0f766e;font-size:.55rem;font-weight:850;line-height:1.2;text-align:right}.finish-delivery-reconciliation-dialog{width:min(620px,calc(100vw - 24px))}.finish-delivery-reconciliation-form{display:grid;gap:12px;padding:14px 16px 16px}.finish-delivery-reconciliation-summary{display:grid;gap:3px;padding:11px 12px;border:1px solid #99f6e4;border-left:4px solid #0d9488;background:#f0fdfa;border-radius:7px}.finish-delivery-reconciliation-summary strong{color:#0f172a;font-size:.92rem}.finish-delivery-reconciliation-summary span{color:#475569;font-size:.7rem}.finish-delivery-reconciliation-summary b{color:#0f766e;font-size:.78rem}.finish-delivery-reconciliation-intro{margin:0;color:#334155;font-size:.76rem;line-height:1.45}.finish-delivery-reconciliation-fields{display:grid;grid-template-columns:1fr 1fr;gap:10px}.finish-delivery-reconciliation-fields label{display:grid;gap:5px;color:#1e3a5f;font-size:.72rem;font-weight:800}.finish-delivery-reconciliation-fields label>span{margin-left:4px;color:#64748b;font-size:.6rem;font-weight:700}.finish-delivery-reconciliation-quantity{display:grid;grid-template-columns:minmax(0,1fr) 88px;gap:7px}.finish-delivery-reconciliation-quantity input{min-width:0}.finish-delivery-reconciliation-wide{grid-column:1/-1}.finish-delivery-reconciliation-actions{justify-content:space-between}.finish-delivery-reconciliation-actions .danger-outline{margin-right:auto}@media(max-width:560px){.finish-queue-summary{align-items:flex-end;flex-direction:column;gap:2px}.finish-queue-washed-summary{max-width:72px;font-size:.49rem}.finish-delivery-reconciliation-form{padding:12px}.finish-delivery-reconciliation-fields{grid-template-columns:1fr}.finish-delivery-reconciliation-wide{grid-column:auto}.finish-delivery-reconciliation-actions{align-items:stretch;flex-direction:column-reverse}.finish-delivery-reconciliation-actions .danger-outline{margin-right:0}}

.finish-rewash-card{margin-bottom:8px}.finish-rewash-card .finish-card-header{align-items:center}.finish-rewash-card .finish-card-header>div:first-child{min-width:0}.finish-rewash-card .finish-card-header>div:first-child span{display:block;margin-top:2px;color:#64748b;font-size:.67rem}.finish-rewash-header-actions{display:flex;align-items:center;gap:8px}.finish-rewash-summary{font-size:.68rem;color:#b45309;white-space:nowrap}.finish-rewash-lines{padding:0 10px}.finish-rewash-empty{padding:9px 1px;color:#64748b;font-size:.72rem}.finish-rewash-lines article{display:grid;grid-template-columns:minmax(0,1fr) minmax(90px,.75fr) auto;gap:10px;align-items:center;padding:7px 2px;border-top:1px solid #f1f5f9}.finish-rewash-lines strong{overflow:hidden;color:#0f172a;font-size:.73rem;text-overflow:ellipsis;white-space:nowrap}.finish-rewash-lines span{overflow:hidden;color:#64748b;font-size:.62rem;text-overflow:ellipsis;white-space:nowrap}.finish-rewash-lines b{color:#b45309;font-size:.72rem;white-space:nowrap}.finish-rewash-dialog{width:min(760px,calc(100vw - 24px))}.finish-rewash-form{display:grid;gap:10px;padding:12px 14px 14px}.finish-rewash-context{grid-template-columns:.8fr .65fr 1.35fr}.finish-rewash-line-section{display:grid;gap:7px}.finish-rewash-line-head,.finish-rewash-batch-line{display:grid;grid-template-columns:minmax(180px,1.4fr) minmax(120px,.8fr) 110px 34px;gap:7px;align-items:center}.finish-rewash-line-head{padding:0 3px;color:#64748b;font-size:.58rem;font-weight:900;letter-spacing:.04em;text-transform:uppercase}.finish-rewash-batch-lines{display:grid;gap:6px;max-height:320px;overflow-y:auto;padding:2px}.finish-rewash-batch-line input{min-width:0}.finish-rewash-batch-line button{min-width:34px;padding:7px 0}.finish-rewash-total{display:flex;justify-content:flex-end;gap:7px;padding-top:7px;border-top:1px solid #e2e8f0;color:#64748b;font-size:.68rem}.finish-rewash-total strong{color:#b45309;font-size:.78rem}@media(max-width:700px){.finish-rewash-context{grid-template-columns:1fr}.finish-rewash-header-actions{width:100%;justify-content:space-between}.finish-rewash-lines article{grid-template-columns:minmax(0,1fr) auto}.finish-rewash-lines span{grid-column:1/-1;grid-row:2}.finish-rewash-line-head{display:none}.finish-rewash-batch-line{grid-template-columns:1fr 1fr 34px}.finish-rewash-batch-line input[data-rewash-customer]{grid-column:1/-1}.finish-rewash-batch-line button{grid-column:3}.finish-rewash-batch-line input[data-rewash-kg]{grid-column:2}}

/* Finish queue: use the route colour across each row for fast production scanning. */
.finish-queue-line{background:var(--route-color);border-color:var(--route-color);border-left-color:var(--route-color);box-shadow:inset 0 0 0 1px rgb(255 255 255 / .12),0 1px 2px #0f172a12;color:var(--route-fg)}
.finish-queue-line:hover:not(:disabled){background:var(--route-color);border-color:var(--route-color);filter:brightness(.95);transform:translateY(-1px)}
.finish-queue-line:focus-visible{outline:3px solid #0f766e;outline-offset:2px}
.finish-queue-order{background:rgb(255 255 255 / .9);color:#334155;box-shadow:0 1px 2px #0f172a1a}
.finish-queue-route{border:1px solid rgb(255 255 255 / .34);background:rgb(255 255 255 / .16);color:var(--route-fg)}
.finish-queue-copy strong,.finish-queue-planned strong{color:var(--route-fg)}
.finish-queue-copy small,.finish-queue-planned small{color:color-mix(in srgb,var(--route-fg) 78%,transparent)}
.finish-queue-status{background:rgb(255 255 255 / .9)!important;color:#334155!important;box-shadow:0 1px 2px #0f172a12}
.finish-queue-line.waiting{background:var(--route-color);opacity:.82}.finish-queue-line.waiting .finish-queue-copy small{color:color-mix(in srgb,var(--route-fg) 78%,transparent)}
.finish-queue-line.processed,.finish-queue-line.continue{opacity:.72;filter:saturate(.78)}
.finish-queue-line.continue:hover:not(:disabled){background:var(--route-color)!important;border-color:var(--route-color)!important}
.finish-queue-line.locked{opacity:.48}

/* 2026-09-23 - stronger Finish visual hierarchy inspired by the current operational app. */
body.finish-page{
  --finish-teal:#0b8b8c;
  --finish-teal-dark:#087678;
  --finish-ink:#10233f;
  --finish-muted:#60738d;
  --finish-line:#cbd8e5;
  --finish-bg:#edf3f8;
  background:var(--finish-bg);
}
.finish-content{padding:14px 18px 28px}
.finish-topbar-compact{
  min-height:84px;
  margin:0 0 12px;
  padding:15px 18px;
  border:1px solid #087678;
  border-radius:14px;
  background:linear-gradient(120deg,#0d999a 0%,#087d80 100%);
  box-shadow:0 8px 22px rgb(8 118 120 / .18);
  color:#fff;
}
.finish-topbar-compact h1{color:#fff;font-size:1.75rem;line-height:1.05}
.finish-topbar-compact .finish-title-meta>span{
  border-color:rgb(255 255 255 / .28);
  background:rgb(255 255 255 / .12);
  color:#eaffff!important;
}
.finish-topbar-compact .finish-shift-tabs{background:rgb(4 73 76 / .34)}
.finish-topbar-compact .finish-shift-tabs button{color:#e9ffff}
.finish-topbar-compact .finish-shift-tabs button.active{
  background:#fff;
  color:#087678;
  box-shadow:0 2px 7px rgb(3 49 51 / .25);
}
.finish-topbar-compact button.secondary{
  border-color:#fff;
  background:#fff;
  color:#12304c;
}
.finish-workspace-tabs{
  margin-bottom:10px;
  border:1px solid #c5d3df;
  background:#dce6ee;
}
.finish-workspace-tabs button{color:#40556f;font-size:.74rem}
.finish-workspace-tabs button.active{color:#087678}
.finish-table-focus-compact{margin-bottom:10px}
.finish-table-focus-compact .finish-table-focus-head{margin-bottom:7px}
.finish-table-focus-compact .finish-table-focus-head h2{color:#12304c;font-size:1rem}
.finish-table-focus-tabs{border:1px solid #c5d3df;background:#dce6ee}
.finish-table-focus-tabs button{color:#40556f}
.finish-table-focus-tabs button.active{color:#087678}
.finish-metrics{
  gap:10px;
  border:0;
  background:transparent;
  box-shadow:none;
  overflow:visible;
}
.finish-kpi{
  min-height:112px;
  padding:17px 16px;
  border:1px solid var(--finish-line)!important;
  border-radius:13px;
  background:#fff!important;
  box-shadow:0 3px 10px rgb(34 65 94 / .08);
  text-align:center;
}
.finish-kpi span{color:#60738d;font-size:.67rem;letter-spacing:.055em}
.finish-kpi strong{margin:5px 0 4px;color:#079294;font-size:1.48rem;line-height:1.05}
.finish-kpi.planned strong{color:#079294}
.finish-kpi small{color:#60738d;font-size:.7rem;font-weight:650}
.finish-kpi .delta-negative{color:#c92828!important;font-weight:850}
.finish-kpi .delta-positive{color:#07844c!important;font-weight:850}
.finish-workspace{gap:12px}
.finish-main-column{gap:12px}
.finish-card,.finish-queue-card,.finish-staff-overview-card{
  border-color:var(--finish-line);
  border-radius:12px;
  box-shadow:0 3px 11px rgb(34 65 94 / .09);
}
.finish-card-header{padding:12px 14px;background:#fff}
.finish-card-header h2,.finish-queue-card h2{color:#10233f;font-size:.96rem}
.finish-card-header p,.finish-queue-card header p{color:#087d80;font-size:.61rem}
.finish-saved-table-head{
  padding:9px 12px;
  background:#f3f7fa;
  color:#51657f;
  font-size:.59rem;
}
.finish-saved-row{
  min-height:58px;
  padding:8px 12px 8px 14px;
  border-bottom-color:#dfe7ef;
}
.finish-saved-row:hover{background:#f7fafc}
.finish-saved-time{color:#60738d;font-size:.7rem}
.finish-saved-customer-cell>strong{color:#10233f;font-size:.82rem}
.finish-saved-batch-row{border-color:#cbd8e5;background:#f4f8fa}
.finish-saved-batch-row b{color:#10233f;font-size:.7rem}
.finish-saved-batch-row em{color:#087d80;font-size:.66rem}
.finish-saved-processor>strong{color:#1e3857;font-size:.73rem}
.finish-rewash-card{border-left:4px solid #f0a51a}
.finish-rewash-summary{color:#a85a05;font-weight:850}
.finish-queue-card header{background:#fff}
.finish-queue-count{
  border:1px solid #83ddda;
  background:#ddf8f6;
  color:#087d80;
}
.finish-queue-washed-summary{color:#087d80}
.finish-queue-mode-tabs{border:1px solid #c5d3df;background:#dce6ee}
.finish-queue-mode-tabs button.active{background:#526173;color:#fff}
.finish-queue-card header input{border-color:#afc1d2;background:#fbfdff}
button.primary,.primary{border-color:#087d80;background:#087d80}
button.primary:hover,.primary:hover{border-color:#066b6d;background:#066b6d}

@media(max-width:700px){
  .finish-content{padding:10px}
  .finish-topbar-compact{min-height:0;padding:14px}
  .finish-topbar-compact h1{font-size:1.45rem}
  .finish-metrics{gap:7px}
  .finish-kpi{min-height:96px;padding:12px 9px}
  .finish-kpi strong{font-size:1.2rem}
}
