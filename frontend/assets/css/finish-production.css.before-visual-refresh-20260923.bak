:root{--finish-teal:#0f766e;--finish-ink:#0f172a;--finish-muted:#64748b;--finish-line:#e2e8f0;--finish-bg:#f1f5f9;--finish-card:#fff}
*{box-sizing:border-box}
body.finish-page{margin:0;background:var(--finish-bg);color:var(--finish-ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
.finish-page-shell{min-height:100vh}
.finish-content{min-width:0;padding:18px 20px 28px;overflow-x:hidden}
.finish-topbar{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;margin-bottom:14px}.finish-topbar p,.finish-card-header p,.finish-queue-card header p,.finish-dialog-header p{margin:0 0 3px;color:#0f766e;font-size:.72rem;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.finish-topbar h1{margin:0;font-size:1.65rem}.finish-topbar>div>span,.finish-card-header span,.finish-queue-card header span,.finish-dialog-header span{color:var(--finish-muted);font-size:.82rem}.finish-top-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}.finish-shift-tabs{display:flex;background:#e2e8f0;border-radius:10px;padding:3px}.finish-shift-tabs button{border:0;background:transparent;padding:8px 12px;border-radius:8px;font-weight:800;cursor:pointer}.finish-shift-tabs button.active{background:#fff;color:#0f766e;box-shadow:0 1px 4px #0f172a14}
.finish-workspace-tabs{display:flex;gap:4px;width:max-content;margin:0 0 8px;padding:3px;border-radius:9px;background:#e2e8f0}.finish-workspace-tabs button{border:0;border-radius:7px;background:transparent;color:#475569;padding:6px 10px;font-size:.7rem;font-weight:900;cursor:pointer}.finish-workspace-tabs button.active{background:#fff;color:#0f766e;box-shadow:0 1px 4px #0f172a14}
button.primary,.primary{border:1px solid #0f766e;background:#0f766e;color:#fff;border-radius:9px;padding:9px 13px;font-weight:800;cursor:pointer}button.secondary,.secondary{border:1px solid #cbd5e1;background:#fff;color:#334155;border-radius:9px;padding:8px 11px;font-weight:800;cursor:pointer;text-decoration:none}button:disabled{opacity:.58;cursor:not-allowed}
.development-data-banner{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid #fdba74;background:#fff7ed;border-radius:10px;color:#9a3412;margin-bottom:10px;font-size:.78rem}.development-data-banner strong{font-size:.7rem;letter-spacing:.06em}.finish-context-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-bottom:8px}.finish-context-strip>div{background:#fff;border:1px solid var(--finish-line);border-radius:10px;padding:9px 11px}.finish-context-strip span{display:block;color:var(--finish-muted);font-size:.7rem;text-transform:uppercase;font-weight:800}.finish-context-strip strong{display:block;margin-top:2px;font-size:.9rem}.finish-message{min-height:20px;margin:5px 0 10px;font-size:.82rem;font-weight:700}.finish-message.success{color:#047857}.finish-message:not(.success):not(:empty){color:#b91c1c}
.finish-table-focus{margin-bottom:14px}.finish-table-focus-head{display:flex;justify-content:space-between;gap:14px;align-items:end;margin-bottom:8px}.finish-table-focus-head p{margin:0 0 3px;color:#0f766e;font-size:.7rem;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.finish-table-focus-head h2{margin:0;font-size:1.05rem}.finish-table-focus-head span{color:#64748b;font-size:.76rem}.finish-table-focus-tabs{display:flex;gap:4px;background:#e2e8f0;padding:3px;border-radius:10px}.finish-table-focus-tabs button{border:0;background:transparent;color:#475569;border-radius:8px;padding:7px 11px;font-weight:850;cursor:pointer}.finish-table-focus-tabs button.active{background:#fff;color:#0f766e;box-shadow:0 1px 4px #0f172a14}.finish-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));background:#fff;border:1px solid var(--finish-line);border-radius:12px;overflow:hidden;box-shadow:0 2px 10px #0f172a08}.finish-kpi{padding:12px 14px;min-width:0;border-right:1px solid #e2e8f0}.finish-kpi:last-child{border-right:0}.finish-kpi span{display:block;color:#64748b;font-size:.67rem;font-weight:850;text-transform:uppercase;letter-spacing:.04em}.finish-kpi strong{display:block;margin:3px 0 2px;font-size:1.18rem;line-height:1.15}.finish-kpi small{display:block;color:#64748b;font-size:.68rem;white-space:normal}.delta-positive{color:#047857!important}.delta-negative{color:#b91c1c!important}
.finish-workspace{display:grid;grid-template-columns:minmax(0,1fr) minmax(330px,390px);gap:14px;align-items:start}.finish-main-column{display:grid;gap:14px}.finish-card,.finish-queue-card,.finish-staff-overview-card{background:#fff;border:1px solid var(--finish-line);border-radius:14px;box-shadow:0 2px 12px #0f172a0b;overflow:hidden}.finish-card-header{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;padding:13px 15px;border-bottom:1px solid var(--finish-line)}.finish-card-header h2,.finish-queue-card h2{margin:0;font-size:1rem}.finish-history{padding:8px 12px}.finish-history>p,.finish-empty{color:var(--finish-muted);font-size:.82rem}.finish-history-row{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:10px 3px;border-bottom:1px solid #eef2f7}.finish-history-row:last-child{border-bottom:0}.finish-history-row strong{font-size:.9rem}.finish-history-row .meta{display:flex;gap:6px;flex-wrap:wrap;margin:4px 0}.finish-history-row .meta span{background:#f1f5f9;border-radius:999px;padding:3px 6px;font-size:.68rem;color:#475569}.finish-history-row .batches{font-size:.76rem;color:#334155}.finish-history-locked{font-size:.7rem;font-weight:800;color:#64748b;text-align:right;max-width:120px}
.finish-queue-card{position:sticky;top:12px;max-height:calc(100vh - 28px);display:flex;flex-direction:column}.finish-queue-card header{padding:12px;border-bottom:1px solid var(--finish-line)}.finish-queue-card header input{width:100%;margin-top:9px;border:1px solid #cbd5e1;border-radius:9px;padding:9px}.finish-queue-legend{display:flex;gap:12px;padding:8px 12px;border-bottom:1px solid #eef2f7;font-size:.7rem;color:#64748b}.finish-queue-legend span{display:flex;align-items:center;gap:4px}.finish-queue-legend i{width:8px;height:8px;border-radius:50%}.finish-queue-legend .ready{background:#16a34a}.finish-queue-legend .continue{background:#f59e0b}.finish-queue-legend .locked{background:#64748b}.finish-queue{overflow:auto;padding:10px;display:grid;gap:8px}.finish-queue-item{border:1px solid #e2e8f0;border-left:5px solid #16a34a;border-radius:10px;padding:10px;background:#fff;cursor:pointer;text-align:left}.finish-queue-item:hover{background:#f8fafc}.finish-queue-item.continue{border-left-color:#f59e0b}.finish-queue-item.locked{border-left-color:#64748b;opacity:.68;cursor:not-allowed}.finish-queue-item .top{display:flex;justify-content:space-between;gap:8px}.finish-queue-item .route{font-size:.72rem;font-weight:900;color:#475569}.finish-queue-item strong{display:block;margin-top:3px}.finish-queue-item small{color:#64748b}.finish-queue-item .progress{margin-top:7px;display:flex;justify-content:space-between;gap:8px;font-size:.76rem}.state-pill{font-size:.68rem;font-weight:900;padding:3px 6px;border-radius:999px;background:#ecfdf5;color:#047857}.continue .state-pill{background:#fff7ed;color:#b45309}.locked .state-pill{background:#e2e8f0;color:#475569}
.finish-dialog{border:0;padding:0;background:transparent;width:min(880px,calc(100vw - 24px));max-width:none}.finish-dialog::backdrop{background:#0f172a99;backdrop-filter:blur(2px)}.finish-dialog-card{background:#fff;border-radius:16px;box-shadow:0 28px 90px #0f172a66;max-height:calc(100vh - 32px);overflow:auto}.finish-dialog-header{position:sticky;top:0;z-index:3;background:#fff;display:flex;justify-content:space-between;gap:14px;align-items:flex-start;padding:15px 17px;border-bottom:1px solid var(--finish-line)}.finish-dialog-header h2{margin:0;font-size:1.15rem}.finish-dialog-header-actions{display:flex;align-items:center;gap:8px}.finish-dialog-close{width:36px;height:36px;border:1px solid #cbd5e1;border-radius:9px;background:#fff;font-size:1.35rem;cursor:pointer}.finish-dialog form{padding:15px 17px}.cutoff-badge{display:inline-flex;background:#f1f5f9;color:#475569!important;border-radius:999px;padding:6px 9px;font-size:.72rem!important;font-weight:900}.finish-edit-banner{display:flex;justify-content:space-between;gap:10px;background:#fff7ed;border:1px solid #fdba74;border-radius:10px;padding:9px 10px;margin-bottom:10px}.finish-edit-banner div{display:flex;flex-direction:column}.finish-edit-banner span{font-size:.73rem;color:#9a3412}.finish-form-grid.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}.finish-dialog label{display:block;margin:9px 0;font-size:.76rem;font-weight:800;color:#334155}.finish-dialog label small{display:block;margin-top:4px;color:#64748b;font-weight:500}.finish-dialog input,.finish-dialog select,.finish-dialog textarea{width:100%;border:1px solid #cbd5e1;border-radius:9px;background:#fff;padding:9px;font:inherit;color:#0f172a}.finish-customer-summary{display:grid;grid-template-columns:1fr auto;gap:12px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:10px;margin:10px 0}.finish-customer-summary div{display:flex;flex-direction:column}.finish-customer-summary small{color:#64748b;margin-top:2px}.finish-section-row{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:15px 0 8px}.finish-section-row>div{display:flex;flex-direction:column}.finish-section-row small{color:#64748b;font-size:.72rem}.finish-batch-lines{display:grid;gap:7px}.finish-batch-line{display:grid;grid-template-columns:1.4fr .7fr .8fr 42px;gap:7px}.finish-batch-line button{border:1px solid #fecaca;border-radius:8px;background:#fff;color:#b91c1c;font-size:1.15rem;cursor:pointer}.finish-total-row{display:flex;justify-content:flex-end;gap:8px;padding:8px 0;color:#475569;font-size:.8rem}.finish-total-row strong{color:#0f172a}.finish-form-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}
.finish-staff-overview-card{overflow:visible}.finish-staff-count{background:#f1f5f9;border-radius:999px;padding:6px 10px;font-size:.78rem}.finish-staff-table-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;padding:12px 14px;border-bottom:1px solid #e2e8f0}.finish-staff-table-summary article{background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:9px}.finish-staff-table-summary strong,.finish-staff-table-summary span,.finish-staff-table-summary b,.finish-staff-table-summary small{display:block}.finish-staff-table-summary span,.finish-staff-table-summary small{font-size:.7rem;color:#64748b}.finish-staff-table-summary b{margin:3px 0;color:#0f766e}.finish-staff-work-list{padding:12px 14px}.finish-staff-group{margin-bottom:16px}.finish-staff-group>header{display:flex;justify-content:space-between;align-items:center;margin-bottom:7px}.finish-staff-group>header strong{font-size:.85rem}.finish-staff-group>header span{font-size:.7rem;color:#64748b}.finish-staff-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.finish-staff-card{border:1px solid #dbe4ea;border-radius:12px;padding:10px;background:#fff}.finish-staff-card.adjusted{border-color:#fbbf24;background:#fffbeb}.finish-staff-card.moved{border-color:#cbd5e1;background:#f8fafc}.finish-staff-card-top{display:flex;justify-content:space-between;gap:8px;align-items:flex-start}.finish-staff-card-top>div{display:flex;flex-direction:column}.finish-staff-card-top>div span{font-size:.7rem;color:#64748b}.finish-staff-state{border-radius:999px;padding:4px 7px;background:#ecfdf5;color:#047857;font-size:.64rem;text-transform:uppercase}.finish-staff-state.adjusted,.finish-staff-state.incoming_actual{background:#fff7ed;color:#b45309}.finish-staff-state.actual_elsewhere{background:#e2e8f0;color:#475569}.finish-staff-card-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:9px}.finish-staff-card-summary>div{background:#f8fafc;border-radius:8px;padding:7px}.finish-staff-card-summary span,.finish-staff-card-summary small{display:block;font-size:.65rem;color:#64748b}.finish-staff-card-summary strong{display:block;margin:2px 0;font-size:.78rem}.finish-staff-performance{margin-top:8px;border:1px solid #d1fae5;background:#ecfdf5;border-radius:9px;padding:8px}.finish-staff-performance span,.finish-staff-performance small{display:block;font-size:.66rem;color:#64748b}.finish-staff-performance strong{display:block;color:#047857;font-size:1rem}.finish-staff-edit{margin-top:8px}.finish-staff-moved-note{margin-top:8px;padding:7px 8px;border-radius:8px;background:#e2e8f0;color:#475569;font-size:.7rem}.finish-staff-dialog{width:min(640px,calc(100vw - 24px))}.finish-staff-form{display:grid;grid-template-columns:1fr 1fr;gap:8px}.finish-staff-form label:nth-of-type(4),.finish-staff-form .finish-form-actions{grid-column:1/-1}
.finish-report-button{border:0;border-radius:8px;background:#fff7ed;color:#9a3412;font-weight:800;padding:7px 9px;cursor:pointer;margin-top:6px}.finish-report-dialog{border:0;border-radius:14px;padding:0;width:min(620px,calc(100vw - 24px));box-shadow:0 24px 80px #0f172a55}.finish-report-dialog::backdrop{background:#0f172a88}.finish-report-card{padding:18px;background:#fff}.finish-report-card header{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid #e2e8f0;padding-bottom:10px}.finish-report-card header button{border:0;background:transparent;font-size:1.5rem;cursor:pointer}.finish-report-types{display:grid;gap:7px;margin:12px 0}.finish-report-types label{display:grid;grid-template-columns:1fr 110px;align-items:center;background:#f8fafc;padding:8px;border-radius:8px}.finish-report-types label span{display:flex;gap:8px;align-items:center}.finish-report-types input{width:100%}.finish-report-card footer{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}.finish-report-status{min-height:20px;font-size:.82rem;font-weight:700}.finish-report-status.error{color:#b91c1c}.finish-report-status.success{color:#047857}
@media(max-width:1100px){.finish-workspace{grid-template-columns:1fr}.finish-queue-card{position:static;max-height:640px}.finish-context-strip{grid-template-columns:repeat(2,1fr)}.finish-staff-grid{grid-template-columns:1fr}.finish-staff-table-summary{grid-template-columns:1fr 1fr 1fr}}
@media(max-width:700px){.finish-content{padding:12px}.finish-topbar{flex-direction:column}.finish-top-actions{justify-content:flex-start}.finish-context-strip{grid-template-columns:1fr 1fr}.finish-table-focus-head{align-items:stretch;flex-direction:column}.finish-table-focus-tabs{width:100%}.finish-table-focus-tabs button{flex:1}.finish-metrics{grid-template-columns:1fr 1fr}.finish-kpi:nth-child(2){border-right:0}.finish-kpi:nth-child(-n+2){border-bottom:1px solid #e2e8f0}.finish-form-grid.two{grid-template-columns:1fr}.finish-batch-line{grid-template-columns:1fr 1fr}.finish-batch-line button{min-height:42px}.finish-customer-summary{grid-template-columns:1fr}.finish-staff-table-summary{grid-template-columns:1fr}.finish-staff-card-summary{grid-template-columns:1fr}.finish-staff-form{grid-template-columns:1fr}.finish-staff-form label:nth-of-type(4),.finish-staff-form .finish-form-actions{grid-column:auto}.finish-dialog{width:calc(100vw - 12px)}.finish-dialog-card{max-height:calc(100vh - 12px)}}

/* Snapshot 111 — existing batch records and trolley scan control */
.finish-queue-trolley{display:block;margin-top:6px;color:#475569;font-size:.72rem;font-weight:750}
.finish-existing-records{margin:12px 0;border:1px solid #dbe4ea;border-radius:11px;background:#f8fafc;overflow:hidden}.finish-existing-records .finish-section-row{margin:0;padding:10px 11px;border-bottom:1px solid #e2e8f0}.finish-existing-record-list{display:grid;gap:0}.finish-existing-record{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 11px;border-bottom:1px solid #e2e8f0;background:#fff}.finish-existing-record:last-child{border-bottom:0}.finish-existing-record.current{background:#ecfdf5}.finish-existing-record>div{min-width:0;display:flex;flex-direction:column;gap:2px}.finish-existing-record>div strong{font-size:.8rem}.finish-existing-record>div span,.finish-existing-record>div small{font-size:.69rem;color:#64748b}.finish-existing-record.current>div span{color:#047857;font-weight:800}.finish-existing-current-label{font-size:.68rem;font-weight:900;color:#047857;background:#d1fae5;border-radius:999px;padding:5px 7px;white-space:nowrap}
.finish-section-row.compact{margin:8px 0}.finish-trolley-production-card{border:1px solid #dbe4ea;border-radius:11px;background:#f8fafc;padding:10px 11px;margin:12px 0}.finish-trolley-production-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.finish-trolley-production-head>div{display:flex;flex-direction:column;gap:2px}.finish-trolley-production-head span{font-size:.69rem;color:#64748b;font-weight:700}.finish-trolley-production-head strong{font-size:.82rem}.finish-trolley-production-actions{display:flex;align-items:center;gap:6px;flex-wrap:wrap;justify-content:flex-end}.finish-trolley-summary{margin-top:8px;border-top:1px solid #e2e8f0;padding-top:8px;font-size:.75rem;color:#475569}.finish-trolley-summary .muted{color:#64748b}.finish-trolley-summary-line{display:flex;justify-content:space-between;gap:10px;align-items:center}.finish-trolley-summary-line>span{display:flex;gap:5px;flex-wrap:wrap}.finish-trolley-summary-line>span b{border:1px solid #cbd5e1;background:#fff;border-radius:7px;padding:3px 5px;font-size:.68rem}.finish-trolley-summary-line>strong{font-size:.7rem}.finish-trolley-summary-line>strong.good{color:#047857}.finish-trolley-summary-line>strong.warn{color:#b45309}.finish-trolley-summary-line>strong.bad{color:#b91c1c}.finish-trolley-summary-line>strong.pending{color:#475569}
.finish-trolley-dialog{width:min(760px,calc(100vw - 24px))}.finish-trolley-dialog-body{padding:15px 17px 17px}.finish-trolley-requirement-card{display:grid;grid-template-columns:auto minmax(0,1fr);gap:12px;align-items:stretch;background:#f8fafc;border:1px solid #dbe4ea;border-radius:12px;padding:10px;margin-bottom:11px}.finish-trolley-required-big{min-width:112px;border-radius:10px;background:#0f766e;color:#fff;padding:11px;display:flex;align-items:center;gap:9px}.finish-trolley-required-big strong{font-size:1.9rem;line-height:1}.finish-trolley-required-big span{font-size:.7rem;font-weight:800;line-height:1.2}.finish-trolley-required-types{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.finish-trolley-required-types>span{display:flex;flex-direction:column;border:1px solid #cbd5e1;background:#fff;border-radius:9px;padding:7px 9px;min-width:94px}.finish-trolley-required-types b{font-size:.76rem}.finish-trolley-required-types small{font-size:.68rem;color:#64748b}.finish-trolley-scan-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:end;margin-bottom:10px}.finish-trolley-scan-row label{margin:0}.finish-trolley-scanned-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin:8px 0}.finish-trolley-scan-item{display:flex;justify-content:space-between;align-items:center;gap:8px;border:1px solid #cbd5e1;border-left:4px solid #94a3b8;border-radius:9px;background:#fff;padding:8px 9px}.finish-trolley-scan-item.good{border-left-color:#16a34a}.finish-trolley-scan-item.bad{border-left-color:#dc2626;background:#fef2f2}.finish-trolley-scan-item.pending{border-left-color:#94a3b8}.finish-trolley-scan-item>div{display:grid;grid-template-columns:auto auto;column-gap:8px;align-items:baseline}.finish-trolley-scan-item>div strong{font-size:.8rem}.finish-trolley-scan-item>div b{font-size:.72rem;color:#0f766e}.finish-trolley-scan-item>div small{grid-column:1/-1;color:#64748b;font-size:.66rem}.finish-trolley-scan-item button{border:0;background:transparent;color:#b91c1c;font-size:1.1rem;cursor:pointer}.finish-trolley-tally{display:flex;align-items:center;gap:10px;flex-wrap:wrap;border:1px solid #dbe4ea;background:#f8fafc;border-radius:9px;padding:8px 9px;font-size:.7rem}.finish-trolley-tally b{margin-left:auto;border-radius:999px;padding:4px 7px}.finish-trolley-tally b.good{background:#dcfce7;color:#166534}.finish-trolley-tally b.warn{background:#ffedd5;color:#9a3412}.finish-trolley-tally b.bad{background:#fee2e2;color:#991b1b}.finish-trolley-tally b.pending{background:#e2e8f0;color:#475569}.finish-trolley-issues{display:grid;gap:7px;margin-top:9px}.finish-trolley-issue{border-radius:9px;padding:8px 9px;font-size:.72rem}.finish-trolley-issue strong{display:block;margin-bottom:4px}.finish-trolley-issue ul{margin:0;padding-left:17px}.finish-trolley-issue small{display:block;margin-top:5px}.finish-trolley-issue.hard{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}.finish-trolley-issue.plan{background:#fff7ed;border:1px solid #fed7aa;color:#9a3412}.finish-trolley-dialog-actions{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:12px}.finish-trolley-dialog-actions>div{display:flex;gap:7px}
@media(max-width:700px){.finish-existing-record{align-items:flex-start;flex-direction:column}.finish-existing-record>button,.finish-existing-current-label{align-self:flex-end}.finish-trolley-production-head{flex-direction:column}.finish-trolley-production-actions{justify-content:flex-start}.finish-trolley-requirement-card{grid-template-columns:1fr}.finish-trolley-required-big{min-width:0}.finish-trolley-scanned-list{grid-template-columns:1fr}.finish-trolley-tally b{margin-left:0}.finish-trolley-dialog-actions{align-items:stretch;flex-direction:column}.finish-trolley-dialog-actions>div{justify-content:flex-end}}

/* Snapshot 113 — clearer new-vs-edit modal state and stronger Finish color accents */
.finish-context-strip>div:nth-child(1){background:linear-gradient(180deg,#eff6ff 0%,#ffffff 100%);border-color:#bfdbfe}
.finish-context-strip>div:nth-child(2){background:linear-gradient(180deg,#ecfdf5 0%,#ffffff 100%);border-color:#a7f3d0}
.finish-context-strip>div:nth-child(3){background:linear-gradient(180deg,#f0fdfa 0%,#ffffff 100%);border-color:#99f6e4}
.finish-context-strip>div:nth-child(4){background:linear-gradient(180deg,#f8fafc 0%,#ffffff 100%);border-color:#cbd5e1}
.finish-table-focus-head p,.finish-card-header p,.finish-queue-card header p,.finish-dialog-header p{color:#0d9488}
.finish-metrics{background:linear-gradient(180deg,#ffffff 0%,#f8fafc 100%)}
.finish-kpi:nth-child(1){background:linear-gradient(180deg,#ecfdf5 0%,#ffffff 100%)}
.finish-kpi:nth-child(2){background:linear-gradient(180deg,#eff6ff 0%,#ffffff 100%)}
.finish-kpi:nth-child(3){background:linear-gradient(180deg,#f8fafc 0%,#ffffff 100%)}
.finish-kpi:nth-child(4){background:linear-gradient(180deg,#f0fdfa 0%,#ffffff 100%)}
.finish-queue-card header{background:linear-gradient(180deg,#f0fdfa 0%,#ffffff 100%)}
.finish-card-header{background:linear-gradient(180deg,#f8fafc 0%,#ffffff 100%)}
.finish-customer-summary{background:linear-gradient(135deg,#ecfeff 0%,#f8fafc 100%);border-color:#99f6e4}
.finish-customer-summary b{color:#0f766e}
.finish-trolley-production-card{background:linear-gradient(180deg,#f8fafc 0%,#ffffff 100%)}
.finish-batch-line input,.finish-batch-line select,.finish-dialog textarea,.finish-dialog input,.finish-dialog select{transition:border-color .15s ease, box-shadow .15s ease, background-color .15s ease}
.finish-batch-line input:focus,.finish-batch-line select:focus,.finish-dialog textarea:focus,.finish-dialog input:focus,.finish-dialog select:focus{outline:none;border-color:#14b8a6;box-shadow:0 0 0 3px #99f6e466;background:#ffffff}
.finish-dialog-header{background:linear-gradient(180deg,#f8fafc 0%,#ffffff 100%)}
.finish-dialog form[data-mode="new"] .finish-dialog-header p{}
.finish-dialog form[data-mode="new"] .finish-customer-summary{border-left:4px solid #14b8a6}
.finish-dialog form[data-mode="continue"] .finish-customer-summary{border-left:4px solid #f59e0b}
.finish-dialog form[data-mode="edit"] .finish-customer-summary{border-left:4px solid #ea580c}
#finishProductionForm[data-mode="new"] .finish-section-row>div strong::after{content:" · New";color:#0f766e;font-size:.78rem}
#finishProductionForm[data-mode="continue"] .finish-section-row>div strong::after{content:" · Continue";color:#b45309;font-size:.78rem}
#finishProductionForm[data-mode="edit"] .finish-section-row>div strong::after{content:" · Correction";color:#c2410c;font-size:.78rem}
#finishProductionForm[data-mode="new"] .finish-form-actions .primary{background:#0f766e;border-color:#0f766e}
#finishProductionForm[data-mode="continue"] .finish-form-actions .primary{background:#b45309;border-color:#b45309}
#finishProductionForm[data-mode="edit"] .finish-form-actions .primary{background:#c2410c;border-color:#c2410c}
.finish-existing-records{background:linear-gradient(180deg,#f8fafc 0%,#ffffff 100%)}
.finish-existing-record.current{background:linear-gradient(180deg,#ecfdf5 0%,#ffffff 100%)}
.finish-edit-banner{background:linear-gradient(180deg,#fff7ed 0%,#ffffff 100%);border-color:#fb923c}
.finish-history-row{border-left:3px solid transparent;padding-left:9px}
.finish-history-row:has(button){border-left-color:#14b8a6}
.finish-history-row .meta span{background:#eef2ff}
.finish-queue-item.ready{background:linear-gradient(180deg,#ffffff 0%,#f0fdf4 100%)}
.finish-queue-item.continue{background:linear-gradient(180deg,#ffffff 0%,#fffbeb 100%)}
.finish-queue-item.locked{background:linear-gradient(180deg,#ffffff 0%,#f8fafc 100%)}

/* Snapshot 114 — route-forward Saved today and processed-by attribution */
.finish-processed-by-field{margin:10px 0 12px!important;padding:10px 11px;border:1px solid #99f6e4;border-left:4px solid #0f766e;border-radius:10px;background:linear-gradient(180deg,#f0fdfa 0%,#ffffff 100%)}
.finish-processed-by-field>small{margin-top:5px!important}.finish-processed-by-field select{font-weight:800}
.finish-history{display:grid;gap:10px;padding:12px}
.finish-saved-card{--route-color:#0f766e;position:relative;border:1px solid #dbe4ea;border-left:8px solid var(--route-color);border-radius:12px;background:#fff;overflow:hidden;box-shadow:0 2px 9px #0f172a0b}
.finish-saved-route{display:flex;align-items:center;gap:8px;padding:8px 10px;background:linear-gradient(90deg,color-mix(in srgb,var(--route-color) 13%,#fff) 0%,#fff 72%);border-bottom:1px solid #eef2f7}
.finish-route-dot{width:12px;height:12px;border-radius:50%;background:var(--route-color);box-shadow:0 0 0 3px color-mix(in srgb,var(--route-color) 18%,transparent);flex:0 0 auto}
.finish-saved-route>div{display:flex;align-items:baseline;gap:7px;min-width:0}.finish-saved-route b{font-size:.75rem;color:#0f172a;letter-spacing:.02em}.finish-saved-route small{font-size:.68rem;color:#64748b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.finish-saved-priority{margin-left:auto;border:1px solid color-mix(in srgb,var(--route-color) 40%,#cbd5e1);background:#fff;border-radius:999px;padding:3px 7px;font-size:.66rem;font-weight:900;color:#334155}
.finish-saved-main{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;padding:10px 11px 6px}.finish-saved-customer{display:flex;flex-direction:column;min-width:0}.finish-saved-customer strong{font-size:.98rem}.finish-saved-customer small{font-size:.68rem;color:#64748b;margin-top:2px}.finish-saved-total{text-align:right;display:flex;flex-direction:column;flex:0 0 auto}.finish-saved-total strong{font-size:1.05rem;color:#0f766e}.finish-saved-total small{font-size:.68rem;color:#64748b}
.finish-saved-batches{display:flex;gap:6px;flex-wrap:wrap;padding:2px 11px 9px}.finish-saved-batch{display:inline-flex;align-items:center;gap:6px;border:1px solid #dbe4ea;border-radius:8px;background:#f8fafc;padding:4px 6px}.finish-saved-batch b{font-size:.7rem}.finish-saved-batch em{font-style:normal;font-size:.67rem;color:#475569}
.finish-saved-footer{display:grid;grid-template-columns:minmax(180px,1fr) minmax(0,2fr) auto;gap:10px;align-items:center;padding:9px 11px;background:#f8fafc;border-top:1px solid #eef2f7}.finish-saved-person{display:flex;flex-direction:column}.finish-saved-person span{font-size:.6rem;text-transform:uppercase;font-weight:900;letter-spacing:.05em;color:#64748b}.finish-saved-person strong{font-size:.78rem;color:#0f172a}.finish-saved-person small{font-size:.66rem;color:#64748b}.finish-saved-meta{display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end}.finish-saved-meta>span,.finish-saved-detail{display:inline-flex;align-items:center;background:#fff;border:1px solid #e2e8f0;border-radius:999px;padding:3px 6px;font-size:.63rem;color:#475569}.finish-saved-footer>button{white-space:nowrap}.finish-saved-empty{padding:18px;text-align:center}
@supports not (color:color-mix(in srgb,#000 10%,#fff)){.finish-saved-route{background:#f8fafc}.finish-route-dot{box-shadow:0 0 0 3px #e2e8f0}.finish-saved-priority{border-color:#cbd5e1}}
@media(max-width:700px){.finish-saved-footer{grid-template-columns:1fr}.finish-saved-meta{justify-content:flex-start}.finish-saved-footer>button,.finish-saved-footer>.finish-history-locked{justify-self:end}.finish-saved-route>div{flex-direction:column;gap:0}}

/* Snapshot 115 — Sorting-inspired route queue and reduced visual noise */
.finish-context-strip{display:flex;gap:7px;flex-wrap:wrap;margin:0 0 8px}.finish-context-strip>div{display:flex;align-items:center;gap:6px;min-width:0;padding:5px 8px;border-radius:999px;background:#fff!important;border-color:#dbe4ea!important}.finish-context-strip span{display:inline;font-size:.58rem}.finish-context-strip strong{display:inline;margin:0;font-size:.72rem}.development-data-banner{padding:6px 9px;margin-bottom:7px}.finish-message{margin:3px 0 7px;min-height:17px}
.finish-table-focus{margin-bottom:10px}.finish-table-focus-head{margin-bottom:6px}.finish-table-focus-head>div:first-child>span{display:none}.finish-metrics{box-shadow:none}.finish-kpi{padding:9px 11px}.finish-kpi strong{font-size:1.05rem}.finish-kpi small{font-size:.62rem}
.finish-workspace{grid-template-columns:minmax(0,1fr) minmax(360px,430px);gap:10px}.finish-card,.finish-queue-card{border-radius:11px;box-shadow:0 2px 8px #0f172a08}.finish-card-header{padding:9px 11px}.finish-card-header>div>span{font-size:.7rem}.finish-history{gap:7px;padding:9px}
.finish-queue-card{top:8px}.finish-queue-card header{padding:9px 10px}.finish-queue-card header span{font-size:.68rem}.finish-queue-card header input{margin-top:6px;padding:7px 8px}.finish-queue-legend{padding:6px 10px;gap:10px}.finish-queue-legend i.todo{background:#f59e0b}.finish-queue-legend i.processed{background:#16a34a}.finish-queue-legend i.route-ready{background:#2563eb}.finish-queue{padding:7px;gap:7px}
.finish-route-group{--route-color:#94a3b8;border:1px solid #dbe4ea;border-radius:10px;background:#fff;overflow:hidden;box-shadow:inset 6px 0 0 var(--route-color)}
.finish-route-group-head{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:7px;align-items:center;padding:7px 8px 7px 12px;background:linear-gradient(90deg,color-mix(in srgb,var(--route-color) 20%,#fff) 0%,#fff 68%);border-bottom:1px solid #e2e8f0}
.finish-route-badge{min-width:38px;height:30px;display:grid;place-items:center;padding:0 6px;border-radius:7px;background:var(--route-color);color:#fff;font-size:.72rem;font-weight:1000;box-shadow:0 2px 7px #0f172a1a}.finish-route-group-head>div:nth-child(2){min-width:0}.finish-route-group-head strong{display:block;font-size:.77rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.finish-route-group-head small{display:block;margin-top:1px;color:#64748b;font-size:.61rem}.finish-route-ready{border-radius:999px;padding:3px 6px;font-size:.58rem;font-weight:950;white-space:nowrap}.finish-route-ready.ready{background:#dbeafe;color:#1d4ed8}.finish-route-ready.progress{background:#f1f5f9;color:#475569}
.finish-route-customer-list{display:grid}.finish-queue-item.visual{display:grid;grid-template-columns:28px minmax(0,1fr) auto;gap:7px;align-items:center;width:100%;border:0;border-bottom:1px solid #eef2f7;border-left:0;border-radius:0;padding:7px 8px 7px 12px;background:#fff!important;box-shadow:none}.finish-queue-item.visual:last-child{border-bottom:0}.finish-queue-item.visual:hover{background:color-mix(in srgb,var(--route-color) 8%,#fff)!important}.finish-queue-item.visual.todo{box-shadow:inset 3px 0 #f59e0b}.finish-queue-item.visual.processed{box-shadow:inset 3px 0 #16a34a}.finish-queue-item.visual.locked{box-shadow:inset 3px 0 #64748b;opacity:.62}.finish-queue-priority{width:25px;height:25px;display:grid;place-items:center;border-radius:50%;background:#f1f5f9;color:#334155;font-size:.62rem;font-weight:950}.finish-queue-main{min-width:0}.finish-queue-main strong{margin:0;font-size:.75rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.finish-queue-main small{display:block;margin-top:1px;font-size:.59rem;color:#64748b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.finish-queue-state{display:inline-flex;align-items:center;gap:3px;border-radius:999px;padding:3px 5px;font-size:.56rem;font-weight:950;white-space:nowrap}.finish-queue-state b{font-size:.7rem}.finish-queue-state.todo{background:#fff7ed;color:#9a3412}.finish-queue-state.processed{background:#dcfce7;color:#166534}.finish-queue-state.locked{background:#e2e8f0;color:#475569}
.finish-saved-card{border-radius:9px;border-left-width:6px;box-shadow:none}.finish-saved-route{padding:6px 8px}.finish-saved-main{padding:7px 9px 4px}.finish-saved-customer strong{font-size:.86rem}.finish-saved-total strong{font-size:.9rem}.finish-saved-batches{padding:1px 9px 6px}.finish-saved-footer{grid-template-columns:minmax(150px,.8fr) minmax(0,2fr) auto;padding:6px 9px;gap:6px}.finish-saved-person strong{font-size:.7rem}.finish-saved-meta>span,.finish-saved-detail{font-size:.57rem;padding:2px 5px}.finish-saved-route-state{margin-left:auto;border-radius:999px;padding:3px 6px;font-size:.57rem;font-weight:950;white-space:nowrap}.finish-saved-route-state.ready{background:#dbeafe;color:#1d4ed8}.finish-saved-route-state.progress{background:#f1f5f9;color:#475569}.finish-saved-priority{margin-left:0}
.finish-processed-by-field{padding:8px 9px;margin:7px 0 9px!important}.finish-processed-by-field>small{font-size:.66rem}.finish-dialog form{padding:11px 14px}.finish-dialog-header{padding:11px 14px}.finish-customer-summary{margin:7px 0;padding:8px}.finish-section-row{margin:10px 0 6px}.finish-form-grid.two{gap:7px}.finish-dialog label{margin:6px 0}.finish-dialog input,.finish-dialog select,.finish-dialog textarea{padding:8px}.finish-form-actions{margin-top:9px}
@supports not (color:color-mix(in srgb,#000 10%,#fff)){.finish-route-group-head{background:#f8fafc}.finish-queue-item.visual:hover{background:#f8fafc!important}}
@media(max-width:1100px){.finish-workspace{grid-template-columns:1fr}.finish-queue-card{max-height:none}.finish-context-strip{display:flex}}

/* Snapshot 116 — two-mode flat Finish list + compact Saved today ledger */
.finish-queue-title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
.finish-queue-count{min-width:30px;height:30px;padding:0 8px;border-radius:999px;background:#0f172a;color:#fff;display:grid;place-items:center;font-size:.72rem}
.finish-queue-mode-tabs{display:grid;grid-template-columns:1fr 1fr;gap:3px;margin-top:8px;padding:3px;border-radius:9px;background:#e2e8f0}
.finish-queue-mode-tabs button{border:0;border-radius:7px;background:transparent;color:#475569;padding:6px 8px;font-size:.69rem;font-weight:900;cursor:pointer}
.finish-queue-mode-tabs button.active{background:#fff;color:#0f766e;box-shadow:0 1px 4px #0f172a14}
.finish-queue-day-tabs{display:grid;grid-template-columns:1fr 1fr;gap:4px;margin-top:6px}
.finish-queue-day-tabs[hidden]{display:none}
.finish-queue-day-tabs button{border:1px solid #cbd5e1;border-radius:8px;background:#fff;color:#475569;padding:6px 7px;text-align:left;cursor:pointer}
.finish-queue-day-tabs button strong,.finish-queue-day-tabs button span{display:block}
.finish-queue-day-tabs button strong{font-size:.66rem}
.finish-queue-day-tabs button span{font-size:.58rem;color:#64748b}
.finish-queue-day-tabs button.active{border-color:#14b8a6;background:#f0fdfa;color:#0f766e;box-shadow:inset 3px 0 0 #14b8a6}
.finish-route-summary{display:flex;gap:5px;overflow-x:auto;padding:6px 8px;border-bottom:1px solid #e2e8f0;background:#f8fafc;scrollbar-width:thin}
.finish-route-chip{--route-color:#64748b;--route-fg:#fff;display:inline-flex;align-items:center;gap:4px;flex:0 0 auto;border:1px solid #cbd5e1;border-radius:999px;background:#fff;padding:3px 6px;font-size:.58rem;color:#475569}
.finish-route-chip b{background:var(--route-color);color:var(--route-fg);border-radius:999px;padding:2px 5px;font-size:.58rem;line-height:1.2}
.finish-route-chip em{font-style:normal;font-weight:900}.finish-route-chip i{font-style:normal;color:#166534;font-weight:1000}.finish-route-chip.ready{border-color:#86efac;background:#f0fdf4;color:#166534}
.finish-queue{padding:5px;gap:3px;background:#eef2f7}
.finish-queue-line{--route-color:#94a3b8;--route-fg:#fff;width:100%;display:grid;grid-template-columns:27px 38px minmax(0,1fr) auto;gap:6px;align-items:center;border:1px solid #d7e0ea;border-left:6px solid var(--route-color);border-radius:7px;background:#fff;padding:6px 7px 6px 6px;text-align:left;color:#0f172a;cursor:pointer;transition:background .12s,border-color .12s,opacity .12s}
.finish-queue-line:hover:not(:disabled){background:#f8fafc;border-color:#94a3b8}.finish-queue-line:disabled{cursor:default}
.finish-queue-order{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;background:#e2e8f0;color:#334155;font-size:.6rem;font-weight:950}
.finish-queue-route{display:grid;place-items:center;min-height:23px;border-radius:6px;background:var(--route-color);color:var(--route-fg);font-size:.57rem;font-weight:1000;padding:2px 4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.finish-queue-copy{min-width:0}.finish-queue-copy strong{display:block;font-size:.75rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.finish-queue-copy small{display:block;margin-top:1px;color:#64748b;font-size:.58rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.finish-queue-status{display:inline-flex;align-items:center;gap:3px;border-radius:999px;padding:3px 5px;font-size:.55rem;font-weight:950;white-space:nowrap}.finish-queue-status b{font-size:.69rem}
.finish-queue-status.todo{background:#fff7ed;color:#9a3412}.finish-queue-status.continue{background:#fef3c7;color:#92400e}.finish-queue-status.processed{background:#dcfce7;color:#166534}.finish-queue-status.locked{background:#e2e8f0;color:#475569}
.finish-queue-line.processed,.finish-queue-line.continue{opacity:.62;filter:saturate(.76)}
.finish-queue-line.processed .finish-queue-copy strong,.finish-queue-line.continue .finish-queue-copy strong{text-decoration:line-through;text-decoration-thickness:2px;text-decoration-color:#475569}
.finish-queue-line.continue{opacity:.76}.finish-queue-line.continue:hover{background:#fffbeb!important;border-color:#fbbf24!important}
.finish-queue-line.locked{opacity:.52}

.finish-saved-head{align-items:center}.finish-saved-summary{display:flex;align-items:baseline;gap:5px;white-space:nowrap}.finish-saved-summary strong{font-size:1rem;color:#0f766e}.finish-saved-summary span{font-size:.62rem;color:#64748b}.finish-saved-summary b{margin-left:4px;font-size:.65rem;color:#334155}
.finish-saved-list{display:block;padding:0;background:#fff}.finish-saved-table-head{display:grid;grid-template-columns:54px minmax(190px,1.7fr) minmax(90px,.75fr) minmax(90px,.7fr) minmax(160px,1.25fr) 58px;gap:8px;align-items:center;padding:6px 10px;background:#0f172a;color:#cbd5e1;font-size:.55rem;font-weight:900;text-transform:uppercase;letter-spacing:.045em}
.finish-saved-row{--route-color:#0f766e;--route-fg:#fff;display:grid;grid-template-columns:54px minmax(190px,1.7fr) minmax(90px,.75fr) minmax(90px,.7fr) minmax(160px,1.25fr) 58px;gap:8px;align-items:center;min-height:52px;padding:7px 10px 7px 12px;border-bottom:1px solid #e2e8f0;box-shadow:inset 6px 0 0 var(--route-color);background:#fff}.finish-saved-row:last-child{border-bottom:0}.finish-saved-row:hover{background:#f8fafc}
.finish-saved-time{font-size:.7rem;font-weight:900;color:#334155}.finish-saved-customer-cell{min-width:0}.finish-saved-customer-cell>strong{display:block;font-size:.78rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.finish-saved-customer-cell>small{display:flex;align-items:center;gap:4px;margin-top:3px;color:#64748b;font-size:.57rem;white-space:nowrap}.finish-saved-route-pill{display:inline-block;border-radius:5px;background:var(--route-color);color:var(--route-fg);padding:2px 5px;font-size:.54rem;line-height:1.2}
.finish-saved-batch-compact{font-size:.69rem;font-weight:850;color:#334155;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.finish-saved-qty{font-size:.73rem;color:#0f766e;white-space:nowrap}.finish-saved-processor{min-width:0}.finish-saved-processor>strong{display:block;font-size:.71rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.finish-saved-processor>small{display:block;margin-top:2px;font-size:.54rem;color:#64748b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.finish-saved-edit{padding:5px 7px!important;font-size:.62rem}.finish-saved-row>.finish-history-locked{max-width:none;font-size:.58rem;text-align:center}

@media(max-width:900px){.finish-saved-table-head{display:none}.finish-saved-row{grid-template-columns:46px minmax(0,1fr) auto;grid-template-areas:"time customer qty" "batch processor action";gap:5px 8px}.finish-saved-time{grid-area:time}.finish-saved-customer-cell{grid-area:customer}.finish-saved-batch-compact{grid-area:batch}.finish-saved-qty{grid-area:qty}.finish-saved-processor{grid-area:processor}.finish-saved-edit,.finish-saved-row>.finish-history-locked{grid-area:action;justify-self:end}}
@media(max-width:520px){.finish-queue-line{grid-template-columns:25px 34px minmax(0,1fr)}.finish-queue-status{grid-column:3;justify-self:start}.finish-saved-summary b{display:none}}
.finish-queue-status.waiting{background:#e0f2fe;color:#075985}.finish-queue-line.waiting{opacity:.72;background:#f8fafc}.finish-queue-line.waiting .finish-queue-copy small{color:#0369a1}

/* Snapshot 117 — production-first compact layout, practical trolley/edit flow */
.finish-content{padding-top:10px}
.finish-topbar-compact{align-items:center;margin-bottom:6px;padding:0 2px}.finish-title-block{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.finish-topbar-compact h1{font-size:1.38rem}.finish-title-meta{display:flex;align-items:center;gap:5px}.finish-title-meta>span{display:inline-flex!important;align-items:center;border:1px solid #dbe4ea;background:#fff;border-radius:999px;padding:4px 7px;color:#475569!important;font-size:.64rem!important;font-weight:850}.finish-dev-compact{display:inline-flex;width:auto;padding:3px 7px;margin:0 0 5px;border-radius:6px;font-size:.61rem;gap:6px}.finish-dev-compact strong{font-size:.58rem}.finish-message{min-height:0;margin:0 0 4px}.finish-message:empty{display:none}
.finish-table-focus-compact{margin-bottom:7px}.finish-table-focus-compact .finish-table-focus-head{align-items:center;margin-bottom:4px}.finish-table-focus-compact .finish-table-focus-head h2{font-size:.88rem;color:#0f766e}.finish-table-focus-tabs{padding:2px}.finish-table-focus-tabs button{padding:5px 9px;font-size:.7rem}.finish-metrics{grid-template-columns:repeat(3,minmax(0,1fr));border-radius:9px}.finish-kpi{padding:7px 10px}.finish-kpi strong{font-size:1rem;margin:1px 0}.finish-kpi span{font-size:.57rem}.finish-kpi small{font-size:.58rem}.finish-kpi:nth-child(1){background:#f0fdf4}.finish-kpi:nth-child(2){background:#fff}.finish-kpi:nth-child(3){background:#f0fdfa}
.finish-workspace{grid-template-columns:minmax(0,1fr) minmax(320px,360px);gap:8px}.finish-card,.finish-queue-card{border-radius:9px}.finish-card-header{padding:7px 9px}.finish-card-header p,.finish-queue-card header p{font-size:.57rem;margin-bottom:1px}.finish-card-header h2,.finish-queue-card h2{font-size:.82rem}.finish-saved-summary strong{font-size:.84rem}.finish-saved-summary b{font-size:.58rem}
